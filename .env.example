# ==========================================
# Ashivam Technologies - Production Configuration
# ==========================================

# 0. Production inquiries API
# Next.js reads NEXT_PUBLIC_* values in browser code at build time.
NEXT_PUBLIC_API_URL=https://ashivam-tech.onrender.com/api/v1

# 1. Authentication Security Secret
# Generate a strong 32+ character random string for production session signing
AUTH_SECRET=replace-with-a-strong-random-secret-before-deployment

# 2. Transactional Email Service (Resend SMTP)
# Create a Resend API key and verify your sending domain before enabling email.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM_EMAIL=notifications@your-verified-domain.com

# 3. Notification Receiver Email
CONTACT_RECEIVER_EMAIL=contact@ashivam.com
